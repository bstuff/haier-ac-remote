{
  "name": "haier-ac-remote",
  "version": "0.3.0",
  "description": "A node module remote controller for Haier air conditioner",
  "keywords": [
    "haier",
    "ac",
    "air",
    "conditioner",
    "smart",
    "home",
    "remote"
  ],
  "author": "Andrew Lavrentev <andrew.lavrentev@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/bstuff/haier-ac-remote/tree/master/packages/homebridge-haier-ac",
  "repository": {
    "type": "git",
    "url": "git://github.com/bstuff/haier-ac-remote.git",
    "directory": "packages/haier-ac-remote"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf ./dist/ && ../../node_modules/.bin/tsc --project ./tsconfig.build.json",
    "run:example": "DEBUG=* node ./dist/examples/index.js",
    "example": "rm -rf ./dist/ && ../../node_modules/.bin/tsc --project ./tsconfig.json && npm run run:example",
    "typecheck": "../../node_modules/.bin/tsc --noEmit --project ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "binary-parser": "^2.3.0",
    "debug": "^4.4.3",
    "hexy": "^0.4.0",
    "rxjs": "^7.8.2"
  }
}
